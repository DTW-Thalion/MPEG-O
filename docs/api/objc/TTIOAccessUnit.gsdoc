    <chapter>
      <heading>
        Software documentation for the
        TTIOTransportChannelData class
      </heading>
      <class name="TTIOTransportChannelData" super="NSObject">
        <declared>TTIOAccessUnit.h</declared>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSObject (NSObject)
          </p>
          <p>
            <em>Declared In:</em> Transport/TTIOAccessUnit.h
          </p>
          <p>
            One signal channel inside a <code>TTIOAccessUnit</code>
            : channel name, precision, optional compression, element
            count, and the encoded payload bytes.
          </p>
        </desc>
        <method type="instancetype" factory="yes">
          <sel>decodeFromBytes:</sel>
          <arg type="const uint8_t*">bytes</arg>
          <sel>length:</sel>
          <arg type="NSUInteger">length</arg>
          <sel>offset:</sel>
          <arg type="NSUInteger*">offset</arg>
          <desc>
            Decode one channel starting at ``offset``. @param
            <var>bytes</var> Pointer to the start of the
            enclosing AU payload. @param <var>length</var>
            Total <var>bytes</var> available at ``bytes``. @param
            <var>offset</var> In/out cursor. On entry, points at
            the channel's first byte; on success, advanced past the
            channel. @return The decoded channel, or ``nil``
            if ``length - *offset`` is too small for the channel
            header or its payload.
          </desc>
        </method>
        <method type="void">
          <sel>appendToBuffer:</sel>
          <arg type="NSMutableData*">buf</arg>
          <desc>
            Append this channel's wire bytes onto ``buf``.
            @param <var>buf</var> Destination buffer. The
            channel header and payload are appended in-place;
            ``buf`` is grown as needed.
          </desc>
        </method>
        <method type="uint8_t">
          <sel>compression</sel>
          <desc>
            Getter for property 'compression' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="NSData*">
          <sel>data</sel>
          <desc>
            Getter for property 'data' with attributes (strong,
            nonatomic, readonly).
          </desc>
        </method>
        <method type="instancetype">
          <sel>initWithName:</sel>
          <arg type="NSString*">name</arg>
          <sel>precision:</sel>
          <arg type="uint8_t">precision</arg>
          <sel>compression:</sel>
          <arg type="uint8_t">compression</arg>
          <sel>nElements:</sel>
          <arg type="uint32_t">nElements</arg>
          <sel>data:</sel>
          <arg type="NSData*">data</arg>
          <desc>
            Designated initialiser. @param <var>name</var>
            Channel <var>name</var> (e.g. ``mz``,
            ``intensity``). @param <var>precision</var>
            Element <var>precision</var>; mirrors
            ``TTIOPrecision``. @param
            <var>compression</var> Compression codec
            <strong>id</strong>; mirrors ``TTIOCompression``.
            Zero means uncompressed. @param <var>nElements</var>
            Number of decoded elements the payload encodes.
            @param <var>data</var> Encoded payload bytes.
            Treated as immutable. @return An initialised
            channel value object.
          </desc>
        </method>
        <method type="uint32_t">
          <sel>nElements</sel>
          <desc>
            Getter for property 'nElements' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="NSString*">
          <sel>name</sel>
          <desc>
            Getter for property 'name' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="uint8_t">
          <sel>precision</sel>
          <desc>
            Getter for property 'precision' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
      </class>
