        <method type="instancetype" factory="yes">
          <sel>decodeFromBytes:</sel>
          <arg type="const uint8_t*">bytes</arg>
          <sel>length:</sel>
          <arg type="NSUInteger">length</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Decode an AU payload from a raw byte buffer. @param
            <var>bytes</var> Pointer to the AU payload (after the
            packet header). @param <var>length</var> Total
            <var>bytes</var> available at ``bytes``. @param
            <var>error</var> On failure, populated with an
            ``NSError`` in the
            ``TTIOTransportErrorDomain``.
            May be ``NULL``. @return A decoded ``TTIOAccessUnit``
            on success; ``nil`` on malformed input.
          </desc>
        </method>
