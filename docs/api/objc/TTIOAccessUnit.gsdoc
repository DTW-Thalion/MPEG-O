          <sel>flags:</sel>
          <arg type="uint16_t">flags</arg>
          <desc>
            Genomic-aware initialiser including the
            GenomicRead suffix fields. Delegates to the
            designated initialiser with
            <code>matePosition = -1</code>,
            <code>templateLength = 0</code>.
          </desc>
        </method>
