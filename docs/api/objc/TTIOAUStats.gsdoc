        <method type="instancetype" factory="yes">
          <sel>statsForAccessUnit:</sel>
          <arg type="TTIOAccessUnit*">au</arg>
          <sel>auSequence:</sel>
          <arg type="uint32_t">auSequence</arg>
          <desc>
            Builds a stats record from an AccessUnit + its
            sequence number. Pure projection: never decodes
            channel payload, never allocates per-element.
            O(channels).
          </desc>
        </method>
        <method type="NSDictionary&lt;NSString*,id&gt;*">
