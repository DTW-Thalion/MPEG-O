    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOSubject class
      </heading>
      <class name="TTIOSubject" super="NSObject">
        <declared>TTIOSubject.h</declared>
        <conform>NSCopying</conform>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSCopying
          </p>
          <p>
            <em>Declared In:</em> Dataset/TTIOSubject.h
          </p>
          <p>
            A study Subject: the donor / patient / animal / object
            the sample was drawn from. First-class TTI-O entity
            introduced in Stage 6 of the transport-spec
            v0.11 work (Deferral 2). Persisted as
            <code>/study/subjects/&lt;external_id&gt;/</code>
            per-row HDF5 groups.
          </p>
          <p>
            <strong>API status:</strong> Stable.
          </p>
          <p>
            <strong>Cross-language equivalents:</strong>
            <br /> Python: <code>ttio.subject.Subject</code>
            <br /> Java:
            <code>global.thalion.ttio.Subject</code>
          </p>
        </desc>
        <method type="NSDictionary*">
          <sel>attributes</sel>
          <desc>
            Getter for property 'attributes' with attributes
            (atomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>attributesJson</sel>
          <desc>
            @return JSON serialisation of
            <code>attributes</code> with sorted keys, matching
            Java's
            <code>
              <ref type="function" id="Subject.attributesJson">
                Subject.attributesJson()
              </ref>
            </code>
            and Python's
            <code>
              json.dumps(d, sort_keys=True,
              separators=(',', ':'))
            </code>
            byte-for-byte. Returns <code>@"{}"</code>
            for an empty map.
          </desc>
        </method>
        <method type="int64_t">
          <sel>birthYear</sel>
          <desc>
            Getter for property 'birthYear' with attributes
            (readonly, atomic, assign).
          </desc>
        </method>
        <method type="NSString*">
          <sel>externalId</sel>
          <desc>
            Getter for property 'externalId' with attributes
            (atomic, readonly, copy).
          </desc>
        </method>
        <method type="instancetype">
          <sel>initWithExternalId:</sel>
          <arg type="NSString*">externalId</arg>
          <sel>project:</sel>
          <arg type="NSString*">project</arg>
          <sel>sex:</sel>
          <arg type="NSString*">sex</arg>
          <sel>birthYear:</sel>
          <arg type="int64_t">birthYear</arg>
          <sel>attributes:</sel>
          <arg type="NSDictionary&lt;NSString*,NSString*&gt;*">attributes</arg>
          <desc>
            Designated initialiser. <code>nil</code> for the
            optional fields is normalised to the defaults (
            <code>@""</code> for strings, <code>@{}</code> for
            <code><var>attributes</var></code>). @param
            <var>externalId</var> Stable, depositor-controlled
            identifier (required, non-empty, no
            <code>'/'</code>). @param <var>project</var> Study
            acronym / cohort identifier (may be
            <code>nil</code>). @param <var>sex</var> Free-form
            <var>sex</var> string (may be <code>nil</code>).
            @param <var>birthYear</var> Year of birth or 0
            sentinel. @param <var>attributes</var> Open
            extension dict (may be <code>nil</code>). @return
            An initialised subject; raises
            <code>NSInvalidArgumentException</code> on
            validation failure (empty / slashed
            <code><var>externalId</var></code>).
          </desc>
        </method>
        <method type="NSString*">
          <sel>project</sel>
          <desc>
            Getter for property 'project' with attributes
            (atomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>sex</sel>
          <desc>
            Getter for property 'sex' with attributes (atomic,
            readonly, copy).
          </desc>
        </method>
      </class>
