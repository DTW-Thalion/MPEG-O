    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the
        TTIOTransportPacketHeader class
      </heading>
      <class name="TTIOTransportPacketHeader" super="NSObject">
        <declared>TTIOTransportPacket.h</declared>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSObject (NSObject)
          </p>
          <p>
            <em>Declared In:</em> Transport/TTIOTransportPacket.h
          </p>
          <p>
            24-byte packet header as a plain value object.
          </p>
        </desc>
        <method type="instancetype" factory="yes">
          <sel>decodeFromBytes:</sel>
          <arg type="const uint8_t*">bytes</arg>
          <sel>length:</sel>
          <arg type="NSUInteger">length</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Decode a 24-byte header from a raw byte buffer.
            @param <var>bytes</var> Pointer to the start of a
            packet (header + payload). @param <var>length</var>
            Number of <var>bytes</var> available at ``bytes``.
            Must be at least ``TTIOTransportHeaderSize``. @param
            <var>error</var> On failure, populated with an
            ``NSError`` in the ``TTIOTransportErrorDomain``
            (``BadMagic``, ``BadVersion``,
            ``Truncated``). May be ``NULL``. @return A
            decoded ``TTIOTransportPacketHeader`` on success;
            ``nil`` on malformed input.
          </desc>
        </method>
        <method type="uint32_t">
          <sel>auSequence</sel>
          <desc>
            Getter for property 'auSequence' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="uint16_t">
          <sel>datasetId</sel>
          <desc>
            Getter for property 'datasetId' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="NSData*">
          <sel>encode</sel>
          <desc>
            Serialise the header to its 24-byte little-endian
            wire form. @return An ``NSData`` of exactly
            ``TTIOTransportHeaderSize``
            bytes.
          </desc>
        </method>
        <method type="uint16_t">
          <sel>flags</sel>
          <desc>
            Getter for property 'flags' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="instancetype">
          <sel>initWithPacketType:</sel>
          <arg type="TTIOTransportPacketType">type</arg>
          <sel>flags:</sel>
          <arg type="uint16_t">flags</arg>
          <sel>datasetId:</sel>
          <arg type="uint16_t">datasetId</arg>
          <sel>auSequence:</sel>
          <arg type="uint32_t">auSequence</arg>
          <sel>payloadLength:</sel>
          <arg type="uint32_t">payloadLength</arg>
          <sel>timestampNs:</sel>
          <arg type="uint64_t">timestampNs</arg>
          <desc>
            Designated initialiser. Builds an immutable
            header value. @param <var>type</var> Known
            packet-type tag. The constructor stores
            ``type`` as both ``packetType`` and
            ``packetTypeByte``. @param
            <var>flags</var> Combination of
            ``TTIOTransportPacketFlag``
            bits; zero is valid. @param <var>datasetId</var>
            Dataset identifier the packet belongs to; zero is
            valid for stream-scoped packets. @param
            <var>auSequence</var> Per-dataset monotonic
            access-unit counter; zero on packets that don't
            carry an AU. @param <var>payloadLength</var> Length
            of the payload that follows this header on the wire.
            @param <var>timestampNs</var> Wall-clock timestamp
            in nanoseconds; the emitter sets the epoch. @return An
            initialised header.
          </desc>
        </method>
        <method type="TTIOTransportPacketType">
          <sel>packetType</sel>
          <desc>
            Getter for property 'packetType' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="uint8_t">
          <sel>packetTypeByte</sel>
          <desc>
            Getter for property 'packetTypeByte' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="uint32_t">
          <sel>payloadLength</sel>
          <desc>
            Getter for property 'payloadLength' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
        <method type="uint64_t">
          <sel>timestampNs</sel>
          <desc>
            Getter for property 'timestampNs' with attributes
            (nonatomic, readonly, assign).
          </desc>
        </method>
      </class>
    </chapter>
