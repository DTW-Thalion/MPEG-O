  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOBamWriterAdapter
        class
      </heading>
      <class name="TTIOBamWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          BAM adapter. opts: none.
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIOCramWriterAdapter
        class
      </heading>
      <class name="TTIOCramWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          CRAM adapter. opts: <code>reference</code> (required;
          reference FASTA).
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIOImzMLWriterAdapter
        class
      </heading>
      <class name="TTIOImzMLWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          imzML adapter. opts: <code>mode</code> (default
          <code>"continuous"</code>).
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIOIsaWriterAdapter
        class
      </heading>
      <class name="TTIOIsaWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          ISA adapter. opts: none (ISA-JSON vs ISA-Tab chosen by
          output suffix).
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the
        TTIOJcampDxWriterAdapter class
      </heading>
      <class name="TTIOJcampDxWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          JCAMP-DX adapter. opts: <code>encoding</code>
          (default <code>"affn"</code>; one of affn / pac /
          sqz / dif).
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIOMzMLWriterAdapter
        class
      </heading>
      <class name="TTIOMzMLWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          <em>Description forthcoming.</em>
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIOMzTabWriterAdapter
        class
      </heading>
      <class name="TTIOMzTabWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          mzTab adapter. opts: <code>dialect</code> (default
          <code>"1.0"</code>).
        </desc>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIONmrMLWriterAdapter
        class
      </heading>
      <class name="TTIONmrMLWriterAdapter" super="NSObject">
        <declared>TTIOWriterAdapters.h</declared>
        <conform>TTIOWriter</conform>
        <desc>
          nmrML adapter. opts: none.
        </desc>
      </class>
    </chapter>
