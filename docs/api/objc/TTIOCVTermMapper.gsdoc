        <method type="BOOL" factory="yes">
          <sel>isSweepWidthAccession:</sel>
          <arg type="NSString*">acc</arg>
          <desc>
            Whether the given accession identifies an NMR
            sweep-width term (NMR:1400014). @param
            <var>acc</var> nmrCV accession string. @return
