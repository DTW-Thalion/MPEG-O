            PSI-MS accession string. @return <code>YES</code>
            iff `acc` is `@"MS:1000130"`.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>isScanStartTimeAccession:</sel>
          <arg type="NSString*">acc</arg>
          <desc>
            Whether the given accession identifies a scan
            start-time term (MS:1000016). @param
            <var>acc</var> PSI-MS accession string. @return
            <code>YES</code> iff `acc` is `@"MS:1000016"`.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>isScanWindowLowerAccession:</sel>
          <arg type="NSString*">acc</arg>
          <desc>
            Whether the given accession identifies the
            scan-window lower limit (MS:1000501). @param
            <var>acc</var> PSI-MS accession string. @return
            <code>YES</code> iff `acc` is `@"MS:1000501"`.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>isScanWindowUpperAccession:</sel>
          <arg type="NSString*">acc</arg>
          <desc>
