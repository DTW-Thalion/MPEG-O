    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOFastaWriter class
      </heading>
      <class name="TTIOFastaWriter" super="NSObject">
        <declared>TTIOFastaWriter.h</declared>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSObject (NSObject)
          </p>
          <p>
            <em>Declared In:</em> Export/TTIOFastaWriter.h
          </p>
          <p>
            FASTA exporter for reference imports and unaligned
            genomic runs. Configurable line-wrap (default 60),
            samtools-compatible <code>.fai</code>
            index emitted alongside, gzip on <code>.gz</code>
            destination.
          </p>
          <p>
            Cross-language byte-equality (uncompressed):
            header is <code>"&gt;name\n"</code>, sequence
            wrapped at the configured width, line endings LF
            only.
          </p>
          <p>
            <strong>Cross-language equivalents:</strong>
            <br /> Python:
            <code>ttio.exporters.fasta.FastaWriter</code> <br />
            Java:
            <code>
              global.thalion.ttio.exporters.FastaWriter
            </code>
          </p>
        </desc>
        <method type="BOOL" factory="yes">
          <sel>writeReadSideRun:</sel>
          <arg type="TTIOGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>lineWidth:</sel>
          <arg type="NSUInteger">lineWidth</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>writeFai:</sel>
          <arg type="BOOL">writeFai</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Write a read-side <code>TTIOGenomicRun</code> as
            FASTA. Used by the FASTA-from- <code>.tio</code>
            export <var>path</var>.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeReadSideRun:</sel>
          <arg type="TTIOGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>lineWidth:</sel>
          <arg type="NSUInteger">lineWidth</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>writeFai:</sel>
          <arg type="BOOL">writeFai</arg>
          <sel>progress:</sel>
          <arg type="TTIOProgressBlock">progress</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Progress-aware overload.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeReference:</sel>
          <arg type="TTIOReferenceImport*">reference</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>lineWidth:</sel>
          <arg type="NSUInteger">lineWidth</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>writeFai:</sel>
          <arg type="BOOL">writeFai</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Write a <var>reference</var> import to
            <code><var>path</var></code>. @param
            <var>reference</var> Source <var>reference</var>.
            @param <var>path</var> Destination <var>path</var>.
            @param <var>lineWidth</var> Sequence wrap width (>=
            1). @param <var>gzipOutput</var> <code>0</code> =
            derive from <code>.gz</code> suffix; <code>1</code>
            = force gzip on; <code>-1</code> = force off. @param
            <var>writeFai</var> When <code>YES</code>, emit a
            samtools-style <code>.fai</code> index
            alongside (skipped silently for gzip output).
            @param <var>error</var> Out-parameter populated on
            failure. @return <code>YES</code> on success.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeReference:</sel>
          <arg type="TTIOReferenceImport*">reference</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>lineWidth:</sel>
          <arg type="NSUInteger">lineWidth</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>writeFai:</sel>
          <arg type="BOOL">writeFai</arg>
          <sel>progress:</sel>
          <arg type="TTIOProgressBlock">progress</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Progress-aware overload. Fires every {@link
            TTIOFastaWriterProgressIntervalReads}
            chromosomes + a final fire.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeRun:</sel>
          <arg type="TTIOWrittenGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>lineWidth:</sel>
          <arg type="NSUInteger">lineWidth</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>writeFai:</sel>
          <arg type="BOOL">writeFai</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Write a write-side genomic <var>run</var> as FASTA.
            Each read becomes one record (quality bytes are
            discarded).
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeRun:</sel>
          <arg type="TTIOWrittenGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>lineWidth:</sel>
          <arg type="NSUInteger">lineWidth</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>writeFai:</sel>
          <arg type="BOOL">writeFai</arg>
          <sel>progress:</sel>
          <arg type="TTIOProgressBlock">progress</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Progress-aware overload.
          </desc>
        </method>
      </class>
