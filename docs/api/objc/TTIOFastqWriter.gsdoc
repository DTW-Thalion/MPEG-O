    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOFastqWriter class
      </heading>
      <class name="TTIOFastqWriter" super="NSObject">
        <declared>TTIOFastqWriter.h</declared>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSObject (NSObject)
          </p>
          <p>
            <em>Declared In:</em> Export/TTIOFastqWriter.h
          </p>
          <p>
            FASTQ exporter. Each read becomes four lines: header
            (<code>@name</code>), sequence, separator (<code>+</code>
            ), and qualities. Internal <code>0xFF</code> "qualities
            unknown" sentinels are mapped to Phred 0 (
            <code>!</code>) on output.
          </p>
          <p>
            <strong>Cross-language equivalents:</strong>
            <br /> Python:
            <code>ttio.exporters.fastq.FastqWriter</code> <br />
            Java:
            <code>
              global.thalion.ttio.exporters.FastqWriter
            </code>
          </p>
        </desc>
        <method type="BOOL" factory="yes">
          <sel>writeReadSideRun:</sel>
          <arg type="TTIOGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>phredOffset:</sel>
          <arg type="uint8_t">phredOffset</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Write a read-side <code>TTIOGenomicRun</code> to
            FASTQ. Used by the FASTQ-from- <code>.tio</code>
            export <var>path</var>.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeReadSideRun:</sel>
          <arg type="TTIOGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>phredOffset:</sel>
          <arg type="uint8_t">phredOffset</arg>
          <sel>progress:</sel>
          <arg type="TTIOProgressBlock">progress</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Progress-aware overload of {@link
            writeReadSideRun:toPath:gzipOutput:phredOffset:error:}.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeRun:</sel>
          <arg type="TTIOWrittenGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>phredOffset:</sel>
          <arg type="uint8_t">phredOffset</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            @param <var>run</var> Source <var>run</var>. @param
            <var>path</var> Destination <var>path</var>. @param
            <var>gzipOutput</var> <code>0</code> = derive from
            <code>.gz</code> suffix; <code>1</code> = force on;
            <code>-1</code> = force off. @param
            <var>phredOffset</var> <code>33</code> (default) or
            <code>64</code>. @param <var>error</var>
            Out-parameter populated on failure. @return
            <code>YES</code> on success.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>writeRun:</sel>
          <arg type="TTIOWrittenGenomicRun*">run</arg>
          <sel>toPath:</sel>
          <arg type="NSString*">path</arg>
          <sel>gzipOutput:</sel>
          <arg type="int">gzipOutput</arg>
          <sel>phredOffset:</sel>
          <arg type="uint8_t">phredOffset</arg>
          <sel>progress:</sel>
          <arg type="TTIOProgressBlock">progress</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Progress-aware overload of {@link
            writeRun:toPath:gzipOutput:phredOffset:error:}.
            Fires {@code progress(written, total)} every {@link
            TTIOFastqWriterProgressIntervalReads}
            records and a final {@code progress(total, total)}.
            Pass <code>nil</code> to skip callbacks.
          </desc>
        </method>
      </class>
    </chapter>
