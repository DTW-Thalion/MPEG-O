    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOReferenceImport
        class
      </heading>
      <class name="TTIOReferenceImport" super="NSObject">
        <declared>TTIOReferenceImport.h</declared>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSObject (NSObject)
          </p>
          <p>
            <em>Declared In:</em> Genomics/TTIOReferenceImport.h
          </p>
          <p>
            Reference-FASTA value class staged for
            embedding into a <code>.tio</code> container.
            Carries chromosome names, per- chromosome sequence
            bytes, and a content MD5 suitable for the
            <code>@md5</code> attribute on
            <code>/study/references/&lt;uri&gt;/</code> groups.
          </p>
          <p>
            Cross-language byte-equal MD5: sort by
            chromosome name, then concatenate per-chromosome
            <code>sequence_bytes</code> verbatim
            (case-preserving, no framing) into the
            digest. Unified in v1.1.0 with the REF_DIFF_V2
            auto-embed writer's stamp; the previous
            <code>name + 0x0A + seq + 0x0A</code> form is gone.
          </p>
          <p>
            <strong>Cross-language equivalents:</strong>
            <br /> Python:
            <code>
              ttio.genomic.reference_import.ReferenceImport
            </code>
            <br /> Java:
            <code>
              global.thalion.ttio.genomics.ReferenceImport
            </code>
          </p>
        </desc>
        <method type="NSData*" factory="yes">
          <sel>computeMd5WithChromosomes:</sel>
          <arg type="NSArray&lt;NSString*&gt;*">chromosomes</arg>
          <sel>sequences:</sel>
          <arg type="NSArray&lt;NSData*&gt;*">sequences</arg>
          <desc>
            Compute the canonical content-MD5 over a chromosome
            set. @param <var>chromosomes</var> Chromosome names.
            @param <var>sequences</var> Per-chromosome bytes.
            @return 16-byte MD5 digest.
          </desc>
        </method>
        <method type="instancetype" factory="yes">
          <sel>readFromGroup:</sel>
          <arg type="id&lt;TTIOStorageGroup&gt;">refGroup</arg>
          <desc>
            <em>Description forthcoming.</em>
          </desc>
        </method>
        <method type="NSData*">
          <sel>chromosomeNamed:</sel>
          <arg type="NSString*">name</arg>
          <desc>
            Look up a chromosome by <var>name</var>. @return
            Sequence bytes, or <code>nil</code> if not
            present.
          </desc>
        </method>
        <method type="NSArray*">
          <sel>chromosomes</sel>
          <desc>
            Getter for property 'chromosomes' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="instancetype">
          <sel>initWithUri:</sel>
          <arg type="NSString*">uri</arg>
          <sel>chromosomes:</sel>
          <arg type="NSArray&lt;NSString*&gt;*">chromosomes</arg>
          <sel>sequences:</sel>
          <arg type="NSArray&lt;NSData*&gt;*">sequences</arg>
          <desc>
            Convenience initialiser that always computes
            the MD5.
          </desc>
        </method>
        <method type="instancetype">
          <sel>initWithUri:</sel>
          <arg type="NSString*">uri</arg>
          <sel>chromosomes:</sel>
          <arg type="NSArray&lt;NSString*&gt;*">chromosomes</arg>
          <sel>sequences:</sel>
          <arg type="NSArray&lt;NSData*&gt;*">sequences</arg>
          <sel>md5:</sel>
          <arg type="NSData*">md5</arg>
          <desc>
            Designated initialiser. Computes MD5 from the
            chromosome set if <code><var>md5</var></code> is
            <code>nil</code>.
          </desc>
        </method>
        <method type="NSData*">
          <sel>md5</sel>
          <desc>
            Getter for property 'md5' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>md5Hex</sel>
          <desc>
            Lowercase-hex form of the MD5.
          </desc>
        </method>
        <method type="NSArray*">
          <sel>sequences</sel>
          <desc>
            Getter for property 'sequences' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="NSUInteger">
          <sel>totalBases</sel>
          <desc>
            Total bases across all chromosomes.
          </desc>
        </method>
        <method type="NSString*">
          <sel>uri</sel>
          <desc>
            Getter for property 'uri' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="BOOL">
          <sel>writeToDataset:</sel>
          <arg type="TTIOSpectralDataset*">dataset</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Convenience wrapper for
            <code>
              <ref type="method" id="-writeToDataset:overwrite:error:">-writeToDataset:overwrite:error:</ref>
            </code>
            that defaults <code>overwrite</code> to
            <code>NO</code>, mirroring Python's keyword-only
            default. @since 1.1.0
          </desc>
        </method>
        <method type="BOOL">
          <sel>writeToDataset:</sel>
          <arg type="TTIOSpectralDataset*">dataset</arg>
          <sel>overwrite:</sel>
          <arg type="BOOL">overwrite</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            <em>Description forthcoming.</em>
          </desc>
        </method>
        <method type="BOOL">
          <sel>writeToDataset:</sel>
          <arg type="TTIOSpectralDataset*">dataset</arg>
          <sel>overwrite:</sel>
          <arg type="BOOL">overwrite</arg>
          <sel>progress:</sel>
          <arg type="TTIOProgressBlock">progress</arg>
          <sel>error:</sel>
          <arg type="NSError**">error</arg>
          <desc>
            Overload of
            <code>
              <ref type="method" id="-writeToDataset:overwrite:error:">-writeToDataset:overwrite:error:</ref>
            </code>
            that fires
            <code>progress(i+1, totalChromosomes)</code> after
            each chromosome is written (and
            <code>progress(0, total)</code> once before the
            loop), mirroring Java's
            <code>writeToDataset(..., ProgressSink)</code> and
            Python's
            <code>write_to_dataset(..., progress=...)</code>.
            @param <var>progress</var> Progress block; pass
            <code>nil</code> for none. @since 1.6.4
          </desc>
        </method>
      </class>
    </chapter>
