    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOSample class
      </heading>
      <class name="TTIOSample" super="NSObject">
        <declared>TTIOSample.h</declared>
        <conform>NSCopying</conform>
        <desc>
          <p>
            <em>Inherits From:</em> NSObject
          </p>
          <p>
            <em>Conforms To:</em> NSCopying
          </p>
          <p>
            <em>Declared In:</em> Dataset/TTIOSample.h
          </p>
          <p>
            A biological / material Sample collected from a
            <code>TTIOSubject</code>, or a standalone sample
            with no recorded subject. First-class TTI-O entity
            introduced in Stage 6 of the transport-spec
            v0.11 work (Deferral 2). Persisted as
            <code>/study/samples/&lt;sample_id&gt;/</code>
            per-row HDF5 groups.
          </p>
          <p>
            The <code>sampleId</code> matches
            <code>TTIOAcquisitionRun.sampleName</code> for the
            run → sample link; that string remains the canonical
            link (no breaking change in Stage 6). When both Sample
            rows and <code>AcquisitionRun.sampleName</code> are
            present, applications SHOULD treat
            <code>sampleName</code> as a foreign key into the
            Sample list. No automatic enrichment.
          </p>
          <p>
            <strong>API status:</strong> Stable.
          </p>
          <p>
            <strong>Cross-language equivalents:</strong>
            <br /> Python: <code>ttio.sample.Sample</code>
            <br /> Java: <code>global.thalion.ttio.Sample</code>
          </p>
        </desc>
        <method type="NSDictionary*">
          <sel>attributes</sel>
          <desc>
            Getter for property 'attributes' with attributes
            (atomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>attributesJson</sel>
          <desc>
            @return JSON serialisation of
            <code>attributes</code> with sorted keys, matching
            Java's
            <code>
              <ref type="function" id="Sample.attributesJson">
                Sample.attributesJson()
              </ref>
            </code>
            and Python's
            <code>
              json.dumps(d, sort_keys=True,
              separators=(',', ':'))
            </code>
            byte-for-byte. Returns <code>@"{}"</code>
            for an empty map.
          </desc>
        </method>
        <method type="int64_t">
          <sel>collectedAt</sel>
          <desc>
            Getter for property 'collectedAt' with attributes
            (readonly, atomic, assign).
          </desc>
        </method>
        <method type="instancetype">
          <sel>initWithSampleId:</sel>
          <arg type="NSString*">sampleId</arg>
          <sel>subjectExternalId:</sel>
          <arg type="NSString*">subjectExternalId</arg>
          <sel>sampleKind:</sel>
          <arg type="NSString*">sampleKind</arg>
          <sel>collectedAt:</sel>
          <arg type="int64_t">collectedAt</arg>
          <sel>attributes:</sel>
          <arg type="NSDictionary&lt;NSString*,NSString*&gt;*">attributes</arg>
          <desc>
            Designated initialiser. <code>nil</code> for the
            optional fields is normalised to the defaults (
            <code>@""</code> for strings, <code>@{}</code> for
            <code><var>attributes</var></code>). @param
            <var>sampleId</var> Primary key (required, non-empty,
            no <code>'/'</code>). @param
            <var>subjectExternalId</var> Soft FK to a Subject
            (may be <code>nil</code>). @param
            <var>sampleKind</var> Free-form kind string (may be
            <code>nil</code>). @param <var>collectedAt</var>
            Unix seconds or 0 sentinel. @param
            <var>attributes</var> Open extension dict (may be
            <code>nil</code>). @return An initialised sample;
            raises <code>NSInvalidArgumentException</code> on
            validation failure (empty / slashed
            <code><var>sampleId</var></code>).
          </desc>
        </method>
        <method type="NSString*">
          <sel>sampleId</sel>
          <desc>
            Getter for property 'sampleId' with attributes
            (atomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>sampleKind</sel>
          <desc>
            Getter for property 'sampleKind' with attributes
            (atomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>subjectExternalId</sel>
          <desc>
            Getter for property 'subjectExternalId' with
            attributes (atomic, readonly, copy).
          </desc>
        </method>
      </class>
    </chapter>
