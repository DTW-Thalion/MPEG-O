  <body>
    <front><contents /></front>
    <chapter>
      <heading>
        Software documentation for the TTIOExporterFormatSpec
        class
      </heading>
      <class name="TTIOExporterFormatSpec" super="NSObject">
        <declared>TTIOExporterRegistry.h</declared>
        <desc>
          <p>
            <em>Declared In:</em> Export/TTIOExporterRegistry.h
          </p>
          <p>
            One immutable entry in the exporter registry: a
            canonical format key paired with its GUI display
            name, output extensions, the external tool it shells
            out to (or <code>nil</code>), and the
            <code>TTIOWriter</code> instance that serializes one
            layer of an opened dataset to an output path.
          </p>
          <p>
            Mirrors Python
            <code>ttio.exporters.registry.ExportSpec</code> and
            Java
            <code>
              global.thalion.ttio.exporters.ExporterRegistry.ExportSpec
            </code>
            .
          </p>
        </desc>
        <method type="NSString*">
          <sel>displayName</sel>
          <desc>
            Getter for property 'displayName' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="NSArray*">
          <sel>extensions</sel>
          <desc>
            Getter for property 'extensions' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="NSString*">
          <sel>key</sel>
          <desc>
            Getter for property 'key' with attributes
            (nonatomic, readonly, copy).
          </desc>
        </method>
        <method type="id&lt;TTIOWriter&gt;">
          <sel>writer</sel>
          <desc>
            Getter for property 'writer' with attributes
            (strong, nonatomic, readonly).
          </desc>
        </method>
      </class>
    </chapter>
    <chapter>
      <heading>
        Software documentation for the TTIOExporterRegistry
        class
      </heading>
      <class name="TTIOExporterRegistry" super="NSObject">
        <declared>TTIOExporterRegistry.h</declared>
        <desc>
          <p>
            <em>Declared In:</em> Export/TTIOExporterRegistry.h
          </p>
          <p>
            Export-format registry: the single source of
            truth for the formats
            <code>ttio export --format &lt;fmt&gt;</code>
            accepts and how each maps a <code>.tio</code> layer
            to an output file. Mirrors the Python
            <code>ttio.exporters.registry</code> module and the
            merged Java <code>ExporterRegistry</code>; the
            canonical key set, alias table and CLI-delegated
            formats are fenced for byte-parity across
            languages.
          </p>
          <p>
            <code>fasta</code> / <code>fastq</code> are
            intentionally NOT registered here
            (CLI_DELEGATED).
          </p>
        </desc>
        <method type="BOOL" factory="yes">
          <sel>exportFormat:</sel>
          <arg type="NSString*">format</arg>
          <sel>tioPath:</sel>
          <arg type="NSString*">tioPath</arg>
          <sel>layer:</sel>
          <arg type="NSString*">layer</arg>
          <sel>output:</sel>
          <arg type="NSString*">output</arg>
          <sel>options:</sel>
          <arg type="NSDictionary&lt;NSString*,id&gt;*">options</arg>
          <sel>error:</sel>
          <arg type="NSError*_Nullable*_Nullable">error</arg>
          <desc>
            Dispatches a <code>.tio</code> &#8594;
            <code><var>output</var></code> for a registry
            format: opens <code><var>tioPath</var></code> via
            <code>
              +[TTIOSpectralDataset
              readFromFilePath:error:]
            </code>
            , then
            <code>
              [spec.writer writeDataset:ds layer:layer
              toOutput:output...]
            </code>
            . @return <code>YES</code> on success; <code>NO</code> +
            <var>error</var> for an unknown <var>format</var> or
            an open/write failure.
          </desc>
        </method>
        <method type="BOOL" factory="yes">
          <sel>isRegistryFormat:</sel>
          <arg type="NSString*">format</arg>
          <desc>
            <code>YES</code> if the (normalised)
            <var>format</var> is a registry key.
          </desc>
        </method>
        <method type="NSString*" factory="yes">
          <sel>normalizeFormat:</sel>
          <arg type="NSString*">format</arg>
          <desc>
            Canonicalises a user token: lowercase + trim
            + alias-map.
          </desc>
        </method>
        <method type="NSArray&lt;NSString*&gt;*" factory="yes">
          <sel>registryKeys</sel>
          <desc>
            The canonical registry keys, sorted ascending.
          </desc>
        </method>
        <method type="TTIOExporterFormatSpec*" factory="yes">
          <sel>specForFormat:</sel>
          <arg type="NSString*">format</arg>
          <sel>error:</sel>
          <arg type="NSError*_Nullable*_Nullable">error</arg>
          <desc>
            The spec for a <var>format</var>, or <code>nil</code> +
            <var>error</var> if unknown.
          </desc>
        </method>
        <method type="NSArray&lt;NSString*&gt;*" factory="yes">
          <sel>supportedExportFormats</sel>
          <desc>
            All formats <code>export</code> accepts: registry keys
            ∪ CLI_DELEGATED, sorted.
          </desc>
        </method>
      </class>
    </chapter>
  </body>
</gsdoc>
