#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly  buffer Quals  { uint8_t  q[]; };
layout(std430, binding = 1)           buffer Models { uint16_t m[]; };
layout(std430, binding = 2) writeonly buffer Out    { uint     acc[]; };

layout(push_constant) uniform P {
    uint seg_symbols;
    uint n_ctx_mask;
    uint stripe;
} pc;

layout(constant_id = 1) const uint NSYM = 48u;

/* 0 models encode: the context sequence comes from the input qualities
 * and is known before any model lookup, so loads can be pipelined.
 * 1 models decode: each context depends on the symbol the coder just
 * produced, so every model load is on the critical path. */
layout(constant_id = 2) const uint FEEDBACK = 0u;

void main() {
    uint chain = gl_GlobalInvocationID.x;
    uint lid   = gl_LocalInvocationID.x;
    uint lsz   = gl_WorkGroupSize.x;
    uint bank  = (pc.n_ctx_mask + 1u) * NSYM;
    uint base  = chain * pc.seg_symbols;
    uint mbase = pc.stripe == 0u ? chain * bank
                                 : gl_WorkGroupID.x * bank * lsz;

    uint ctx = 0u;
    uint state = 1u;
    for (uint i = 0u; i < pc.seg_symbols; i++) {
        uint qi   = uint(q[base + i]);
        uint sym  = (FEEDBACK == 0u ? qi : qi + (state & 0xFFu)) % NSYM;
        uint off  = (ctx & pc.n_ctx_mask) * NSYM + sym;
        uint slot = pc.stripe == 0u ? mbase + off
                                    : mbase + off * lsz + lid;
        uint f = uint(m[slot]);
        m[slot] = uint16_t(f + 32u);
        state = state * 0x9E3779B1u + f;
        ctx = (ctx << 3u) + sym;
    }
    acc[chain] = state;
}
