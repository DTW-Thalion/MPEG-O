<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>global.thalion</groupId>
    <artifactId>tio-browser</artifactId>
    <version>1.6.0</version>
    <packaging>jar</packaging>

    <name>tio-browser</name>
    <description>JavaFX desktop GUI for inspecting, importing, exporting,
                 and transporting TTI-O .tio multi-omics datasets.</description>

    <licenses>
        <license>
            <name>LGPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- JDK 22 required: the ttio dependency uses the FFM API
             (stable in 22) for compound-type HDF5 reads/writes. A JDK 17
             runtime can't load the resulting classes (class file version
             66). Minimum bumped from 17 to 22 to match ttio's compile
             target and resolve the "Hdf5CompoundIO$FieldKind preview
             features are not enabled" load error from the initial
             v1.4.1 build (re-tagged after this fix). -->
        <maven.compiler.source>22</maven.compiler.source>
        <maven.compiler.target>22</maven.compiler.target>
        <javafx.version>21.0.5</javafx.version>
        <ttio.version>1.6.0</ttio.version>
    </properties>

    <repositories>
        <repository>
            <id>local-jhi5</id>
            <url>file://${project.basedir}/local-repo</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>global.thalion</groupId>
            <artifactId>ttio</artifactId>
            <version>${ttio.version}</version>
        </dependency>

        <!-- WebSocket client/server for Transport upload/download -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.7</version>
        </dependency>

        <dependency>
            <groupId>org.hdfgroup</groupId>
            <artifactId>jarhdf5</artifactId>
            <version>1.14.6</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>testfx-junit5</artifactId>
            <version>4.0.18</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testfx</groupId>
            <artifactId>openjfx-monocle</artifactId>
            <version>17.0.10</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>
                        --enable-native-access=ALL-UNNAMED
                        -Djava.library.path=/usr/local/lib:${project.basedir}/../native/_build
                        -Dtestfx.robot=glass
                        -Dtestfx.headless=true
                        -Dprism.order=sw
                        -Dprism.text=t2k
                        -Dheadless.geometry=1600x900-32
                    </argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>global.thalion.ttio.browser.AppLauncher</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      Phase 13.2: native-package profile wraps jpackage to produce a
      platform-native installer (.deb / .rpm / .msi / .pkg, autodetected).

      Activate with:  mvn -P native-package -DskipTests package

      Output: target/installer/tio-browser_VERSION_ARCH.EXT

      Linux .deb requires:  apt install fakeroot dpkg-dev
      Linux .rpm requires:  apt install rpm
      All formats require:  binutils (objcopy)
      Requires JDK 14+ (jpackage); tested with OpenJDK 21.

      Pipeline:
       1. maven-resources-plugin copies the shaded JAR into a clean
          target/installer-staging/ dir.
       2. exec-maven-plugin invokes jpackage with the input arg pointing
          at the staging dir.

      The staging dir is cosmetic, not size-reducing: jpackage's
      main-jar argument already filters target/ down to the named JAR's
      transitive deps. The ~66 MB .deb is dominated by the bundled JRE,
      not the input-dir contents. A future optimization (a list of
      add-modules pinning the needed JDK modules: java.base, java.logging,
      javafx.controls, javafx.graphics, javafx.fxml) would slim the JRE.

      The staging dir's value is making the input scope explicit so a
      future change to target/ contents (e.g. a new build artifact) can't
      accidentally land in the installer.

      The icon is src/main/resources/icons/app-icon.png — the Thalion
      "T" mark fetched from biobank.thalion.global, rasterized to
      512x512 transparent PNG.
    -->
    <profiles>
        <profile>
            <id>native-package</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>stage-jpackage-input</id>
                                <!-- Must run before jpackage (also bound to package). The shaded JAR
                                     itself is produced by maven-shade-plugin on package, which is
                                     phase-bound but earlier in the package goal sequence due to plugin
                                     declaration order. We re-stage during package's later sub-phase
                                     by ordering this execution after the shade plugin in the parent
                                     build. Concretely: maven-shade-plugin → maven-resources-plugin
                                     (staging) → exec-maven-plugin (jpackage). -->
                                <phase>package</phase>
                                <goals><goal>copy-resources</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/installer-staging</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>tio-browser-${project.version}-${platform.classifier}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.4.1</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <argument>--input</argument>
                                        <argument>target/installer-staging</argument>
                                        <argument>--main-jar</argument>
                                        <argument>tio-browser-${project.version}-${platform.classifier}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>global.thalion.ttio.browser.AppLauncher</argument>
                                        <argument>--name</argument>
                                        <argument>tio-browser</argument>
                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Thalion</argument>
                                        <argument>--icon</argument>
                                        <argument>src/main/resources/icons/app-icon.png</argument>
                                        <argument>--dest</argument>
                                        <argument>target/installer</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          Phase A.2 (per-platform-bundled-HDF5): platform profiles select
          the JavaFX classifier deps for the active build target. Activate
          one with: mvn -P linux-x64 ...   (or mac-aarch64 / win-x64).

          ${platform.classifier} feeds Phase A.3 (shade finalName) and
          Phase F.1 (jpackage). ${javafx.classifier} drives the openjfx
          Maven artifact classifiers (note: openjfx names differ from the
          platform names — linux-x64 -> linux, win-x64 -> win, mac-aarch64
          stays mac-aarch64).

          Intel macOS (mac classifier) is intentionally not shipped.
        -->
        <profile>
            <id>linux-x64</id>
            <properties>
                <platform.classifier>linux-x64</platform.classifier>
                <javafx.classifier>linux</javafx.classifier>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
            </dependencies>
            <build>
                <finalName>tio-browser-${project.version}-${platform.classifier}</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>native/mac-aarch64/**</exclude>
                                        <exclude>native/win-x64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>mac-aarch64</id>
            <properties>
                <platform.classifier>mac-aarch64</platform.classifier>
                <javafx.classifier>mac-aarch64</javafx.classifier>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
            </dependencies>
            <build>
                <finalName>tio-browser-${project.version}-${platform.classifier}</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>native/linux-x64/**</exclude>
                                        <exclude>native/win-x64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>win-x64</id>
            <properties>
                <platform.classifier>win-x64</platform.classifier>
                <javafx.classifier>win</javafx.classifier>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-controls</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-graphics</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
                <dependency>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-fxml</artifactId>
                    <version>${javafx.version}</version>
                    <classifier>${javafx.classifier}</classifier>
                </dependency>
            </dependencies>
            <build>
                <finalName>tio-browser-${project.version}-${platform.classifier}</finalName>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>${project.groupId}:${project.artifactId}</artifact>
                                    <excludes>
                                        <exclude>native/linux-x64/**</exclude>
                                        <exclude>native/mac-aarch64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
