<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>global.thalion</groupId>
    <artifactId>ttio</artifactId>
    <version>1.7.1</version>
    <packaging>jar</packaging>

    <name>TTI-O</name>
    <description>Java implementation of the TTI-O multi-omics spectral data container</description>

    <licenses>
        <license>
            <name>LGPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Minimum JDK: 22. FFM (Foreign Function and Memory) APIs in
             java.lang.foreign.* are stable since 22 (preview in 21);
             VlBytesFFM.java uses them directly. Source/target = 22 means
             emitted class files have major version 66 (stable, no
             enable-preview flag at runtime). Compile- and run-time JDKs
             of any version >= 22 (incl. 25) all work. -->
        <maven.compiler.source>22</maven.compiler.source>
        <maven.compiler.target>22</maven.compiler.target>
        <!-- Runtime native-library search path for JHI5 / libttio_rans_jni.
             The L3 V4 (CRAM 3.1 fqzcomp) tests need libttio_rans_jni.so on
             java.library.path. The native build dir is appended so
             `mvn test` works from any session without a per-invocation
             -Dhdf5.native.path override. CI/devs without the native build
             still pass — V4 tests are gated on TtioRansNative.isAvailable(). -->
        <hdf5.native.path>/usr/local/lib:${project.basedir}/../native/_build</hdf5.native.path>
    </properties>

    <!-- jarhdf5 isn't on Maven Central; vendor the JNI binding jar in a
         file-system repo shared with tio-browser. Using a regular compile-
         scope dep (no <scope>system</scope>) avoids the systemPath pom-
         validation gotcha that flagged ttio's installed pom as "invalid"
         on Windows and silently dropped htsjdk + bcprov + sqlite-jdbc
         from tio-browser's shaded JAR. -->
    <repositories>
        <repository>
            <id>local-jhi5</id>
            <url>file://${project.basedir}/../tio-browser/local-repo</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- HDF5 Java bindings (source-built HDF5 1.14.6 via scripts/install-hdf5.sh).
             Resolves from the local-repo above, which vendors the
             jarhdf5-1.14.6.jar that HDF Group's autotools build emits. -->
        <dependency>
            <groupId>org.hdfgroup</groupId>
            <artifactId>jarhdf5</artifactId>
            <version>1.14.6</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- V5 (verification workplan): jqwik for property-based codec tests.
             Default 1000 tries per property; deterministic seed in CI.
             See docs/verification-workplan.md §V5. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.9.1</version>
            <scope>test</scope>
        </dependency>

        <!-- SQLite JDBC for SqliteProvider -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- v0.8 M49: Bouncy Castle for ML-KEM-1024 + ML-DSA-87 (PQC).
             Python/ObjC use liboqs; Java uses BC because liboqs's Java
             bindings are immature and BC is production-ready as of 1.79.
             See docs/pqc.md for the discrepancy rationale. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.80</version>
        </dependency>

        <!-- v0.10 M68: streaming transport over WebSocket. -->
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <version>1.5.7</version>
        </dependency>

        <!-- v1.5.0: htsjdk replaces the samtools subprocess in
             importers/BamReader + exporters/BamWriter / CramWriter.
             Pure-Java SAM/BAM/CRAM read+write so tio-browser works
             on Windows without requiring a system samtools install
             (incident: v1.4.0 launched but could not open .tio files
             with genomic data on Windows). -->
        <dependency>
            <groupId>com.github.samtools</groupId>
            <artifactId>htsjdk</artifactId>
            <version>4.1.3</version>
        </dependency>

        <!-- transport-spec v0.11: Apache Arrow for tabular packet
             payloads (Task 0.1 of the v0.11 implementation plan).
             arrow-memory-netty is runtime-scoped — only the off-heap
             allocator backend is needed; arrow-vector is the
             compile-time API surface. -->
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-vector</artifactId>
            <version>16.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.arrow</groupId>
            <artifactId>arrow-memory-netty</artifactId>
            <version>16.0.0</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Structural JSON reader for the SQLite compound-dataset encoding.
             Already on the classpath transitively via Arrow; declared direct
             so the reader (SqliteProvider) does not rely on a transitive. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>
    </dependencies>

    <!-- (Previously: linux-system-hdf5 profile set hdf5.jar.path +
         hdf5.native.path with <os><family>unix</family></os> activation.
         Moved to project-level <properties> above so the installed pom
         validates on all OSes. The L3 V4 (CRAM 3.1 fqzcomp) test path
         note about hdf5.native.path is preserved by the property
         comment.) -->

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <!-- source/target come from the
                     maven.compiler.source / target properties at the
                     top of this pom (set to 22 for stable FFM). -->
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- ${argLine} expands to JaCoCo's prepare-agent
                         flags (V1, verification workplan) when JaCoCo
                         is active; expands to empty string otherwise.
                         The add-opens=java.base/java.nio flag is
                         required by arrow-memory-core (transport-spec
                         v0.11 Task 1.1+: Arrow IPC encode/decode);
                         without it MemoryUtil's reflective Buffer.address
                         lookup fails with InaccessibleObjectException on
                         JDK 17+. -->
                    <argLine>@{argLine} -Djava.library.path=${hdf5.native.path} --enable-native-access=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <!-- v0.7 M51: the compound-parity dumper
                     global.thalion.ttio.tools.DumpIdentifications is
                     intended to be run via `mvn exec:java`. System-
                     scoped deps (jhdf5) need to be force-included on
                     the exec classpath so the tool can open HDF5
                     files the same way Surefire does. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <includeProjectDependencies>true</includeProjectDependencies>
                    <includePluginDependencies>false</includePluginDependencies>
                    <classpathScope>runtime</classpathScope>
                    <includeSystemScope>true</includeSystemScope>
                    <systemProperties>
                        <systemProperty>
                            <key>java.library.path</key>
                            <value>${hdf5.native.path}</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
            <!--
              V1 (verification workplan): JaCoCo line + branch coverage.
              `mvn verify` (or `mvn test`) produces target/site/jacoco/
              with jacoco.xml + index.html. CI uploads as artifacts.
              C7 added the BUNDLE LINE COVEREDRATIO check below — set
              1 pt below the post-C-series Java baseline (~86%) to
              allow drift while catching regressions. Bump after
              intentional improvements; never lower without a
              recorded reason. See docs/verification-workplan.md §V1
              and docs/coverage-workplan.md §C7.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- W1: workbench client surfaces whose
                                 only meaningful coverage comes from
                                 a live `tti-workbench-server`
                                 round-trip (the WS driver + the REST
                                 login client). Excluded from THIS
                                 always-on gate (the daemon only runs
                                 in workbench-live.yml) so the BUNDLE
                                 rule reflects the actually-tested
                                 surface. As of R7 (2026-06-16) these
                                 classes ARE coverage-GATED in
                                 workbench-live.yml via the
                                 `live-coverage` profile at the bottom
                                 of this pom. See docs/superpowers/
                                 plans/2026-06-16-r7-live-coverage-gate.md. -->
                            <excludes>
                                <exclude>**/workbench/transport/WorkbenchTransportClient*</exclude>
                                <exclude>**/workbench/auth/Login*</exclude>
                                <exclude>**/workbench/auth/BootstrapAdminAuth*</exclude>
                                <exclude>**/workbench/auth/PasswordTotpAuth*</exclude>
                                <!-- W3: REST clients whose meaningful
                                     coverage needs a live daemon. The
                                     pure-data records (Job, Pipeline,
                                     JobEvent, CohortPredicate /
                                     CohortQuery / CohortResult) stay
                                     measured. -->
                                <exclude>**/workbench/WorkbenchHttp*</exclude>
                                <exclude>**/workbench/pipeline/PipelinesClient*</exclude>
                                <exclude>**/workbench/jobs/JobsClient*</exclude>
                                <!-- W4: sessions REST + WS proxy. The
                                     pure-data Session record, SessionProxy
                                     builders, and BindMountValidator stay
                                     measured. -->
                                <exclude>**/workbench/sessions/SessionsClient*</exclude>
                                <exclude>**/workbench/sessions/SessionProxyAttach*</exclude>
                                <!-- W5.2: containers REST. Pure-data
                                     records (Container, ContainerDetail,
                                     ContainerListPage, ContainerLayer,
                                     ContainerManifest) stay measured. -->
                                <exclude>**/workbench/containers/ContainersClient*</exclude>
                                <!-- Indexable: a generic interface whose only
                                     instrumented lines are two uncovered
                                     default-method throw bodies; unexcluded it
                                     makes the protocols package show 0% and trip
                                     the PACKAGE floor. -->
                                <exclude>**/protocols/Indexable*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/workbench/transport/WorkbenchTransportClient*</exclude>
                                <exclude>**/workbench/auth/Login*</exclude>
                                <exclude>**/workbench/auth/BootstrapAdminAuth*</exclude>
                                <exclude>**/workbench/auth/PasswordTotpAuth*</exclude>
                                <!-- W3: REST clients whose meaningful
                                     coverage needs a live daemon. The
                                     pure-data records (Job, Pipeline,
                                     JobEvent, CohortPredicate /
                                     CohortQuery / CohortResult) stay
                                     measured. -->
                                <exclude>**/workbench/WorkbenchHttp*</exclude>
                                <exclude>**/workbench/pipeline/PipelinesClient*</exclude>
                                <exclude>**/workbench/jobs/JobsClient*</exclude>
                                <!-- W4: sessions REST + WS proxy. The
                                     pure-data Session record, SessionProxy
                                     builders, and BindMountValidator stay
                                     measured. -->
                                <exclude>**/workbench/sessions/SessionsClient*</exclude>
                                <exclude>**/workbench/sessions/SessionProxyAttach*</exclude>
                                <!-- W5.2: containers REST. Pure-data
                                     records (Container, ContainerDetail,
                                     ContainerListPage, ContainerLayer,
                                     ContainerManifest) stay measured. -->
                                <exclude>**/workbench/containers/ContainersClient*</exclude>
                                <!-- Indexable: a generic interface whose only
                                     instrumented lines are two uncovered
                                     default-method throw bodies; unexcluded it
                                     makes the protocols package show 0% and trip
                                     the PACKAGE floor. -->
                                <exclude>**/protocols/Indexable*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/workbench/transport/WorkbenchTransportClient*</exclude>
                                <exclude>**/workbench/auth/Login*</exclude>
                                <exclude>**/workbench/auth/BootstrapAdminAuth*</exclude>
                                <exclude>**/workbench/auth/PasswordTotpAuth*</exclude>
                                <!-- W3: REST clients whose meaningful
                                     coverage needs a live daemon. The
                                     pure-data records (Job, Pipeline,
                                     JobEvent, CohortPredicate /
                                     CohortQuery / CohortResult) stay
                                     measured. -->
                                <exclude>**/workbench/WorkbenchHttp*</exclude>
                                <exclude>**/workbench/pipeline/PipelinesClient*</exclude>
                                <exclude>**/workbench/jobs/JobsClient*</exclude>
                                <!-- W4: sessions REST + WS proxy. The
                                     pure-data Session record, SessionProxy
                                     builders, and BindMountValidator stay
                                     measured. -->
                                <exclude>**/workbench/sessions/SessionsClient*</exclude>
                                <exclude>**/workbench/sessions/SessionProxyAttach*</exclude>
                                <!-- W5.2: containers REST. Pure-data
                                     records (Container, ContainerDetail,
                                     ContainerListPage, ContainerLayer,
                                     ContainerManifest) stay measured. -->
                                <exclude>**/workbench/containers/ContainersClient*</exclude>
                                <!-- Indexable: a generic interface whose only
                                     instrumented lines are two uncovered
                                     default-method throw bodies; unexcluded it
                                     makes the protocols package show 0% and trip
                                     the PACKAGE floor. -->
                                <exclude>**/protocols/Indexable*</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Restored to 0.84 (from a temporary 0.76 floor
                                                 introduced in PR #45) by the coverage-restoration
                                                 plan landed in #50: targeted tests added for
                                                 tools.* CLIs (J.1, J.4b), transport.{Reader,Writer}
                                                 (J.2), Hdf5CompoundIO VL_BYTES paths (J.3),
                                                 ZarrProvider (J.4), plus Hdf5Dataset/Group and
                                                 SpectralDataset/SqliteProvider helpers (J.4b).
                                                 Local mvn verify now lands at ~87% line coverage
                                                 (after the R1 CLI tests + R3 fqzcomp dead-code
                                                 removal), so the 0.84 floor has a wider buffer
                                                 than the earlier ~84.2% figure. FqzcompNx16Z remains
                                                 deferred (needs FASTQ corpus — see plan).
                                                 Ratcheted to 0.86 (R6, 2026-06-06) to lock in the
                                                 ~87% actual; never decrease without a recorded
                                                 reason. -->
                                            <minimum>0.86</minimum>
                                        </limit>
                                        <!-- Branch-coverage gate (R4). No-regression floor:
                                             gated bundle branch ratio is ~0.695 (2026-06-06,
                                             post-R1/R3). 0.68 leaves ~1pt buffer; ratchet up
                                             in R6 as branch coverage improves. -->
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.68</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- R5 per-package floor: no package below 50%
                                     line coverage, so a subsystem can't silently
                                     regress behind the BUNDLE aggregate. Lowest
                                     gated package ~55.7% (importers.readers,
                                     2026-06-06); 0.50 leaves buffer. Shares the
                                     excludes above. Ratchet in R6. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <source>22</source>
                    <doctitle>TTI-O Java API (v1.0.0)</doctitle>
                    <windowtitle>TTI-O Java API</windowtitle>
                    <show>protected</show>
                    <!-- Reproducible output: drop the per-page dc.created
                         date so regenerating the committed docs/api/java
                         only diffs on real API changes, not the build day. -->
                    <notimestamp>true</notimestamp>
                    <failOnWarnings>false</failOnWarnings>
                    <doclint>none</doclint>
                    <additionalOptions>
                        <additionalOption>-Xdoclint:none</additionalOption>
                    </additionalOptions>
                    <links>
                        <link>https://docs.oracle.com/en/java/javase/21/docs/api/</link>
                    </links>
                    <reportOutputDirectory>${project.basedir}/../docs/api/java</reportOutputDirectory>
                    <destDir>.</destDir>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- R7: live-daemon workbench-client coverage gate. Activated by
             scripts/workbench-live-smoke.sh (TTIOWB_COVERAGE=1) under
             .github/workflows/workbench-live.yml, where a real
             tti-workbench-server daemon runs. The default jacoco config
             EXCLUDES the workbench client classes from instrumentation (their
             only meaningful coverage is a live round-trip); this profile
             re-instruments them and runs a workbench-scoped check. The default
             `mvn verify` (no profile) and ci.yml's gates are unaffected — the
             base report/check stay at the `verify` phase, which the runner's
             `mvn ... prepare-package` does not reach.
             See docs/superpowers/plans/2026-06-16-r7-live-coverage-gate.md. -->
        <profile>
            <id>live-coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <!-- Override the base agent config: instrument the
                                 workbench classes too (drop the workbench
                                 excludes; keep only the Indexable interface). -->
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <configuration combine.self="override">
                                    <excludes>
                                        <exclude>**/protocols/Indexable*</exclude>
                                    </excludes>
                                </configuration>
                            </execution>
                            <!-- Workbench-scoped report (uploaded as an artifact)
                                 at prepare-package, after surefire writes
                                 jacoco.exec. -->
                            <execution>
                                <id>jacoco-live-workbench-report</id>
                                <phase>prepare-package</phase>
                                <goals><goal>report</goal></goals>
                                <configuration>
                                    <includes>
                                        <include>**/workbench/**</include>
                                    </includes>
                                    <outputDirectory>${project.build.directory}/jacoco-workbench</outputDirectory>
                                </configuration>
                            </execution>
                            <!-- The gate: scoped to the client classes the
                                 default config excludes + the live test drives.
                                 Floor set empirically (0.00 = measurement). -->
            <execution>
                                <id>jacoco-live-workbench-check</id>
                                <phase>prepare-package</phase>
                                <goals><goal>check</goal></goals>
                                <configuration>
                                    <haltOnFailure>true</haltOnFailure>
                                    <!-- The live-driven excluded client classes. PasswordTotpAuth
                                         (the live test uses bootstrap-admin auth) and
                                         SessionProxyAttach (no WS session attach in the live test,
                                         mirroring Python's session_proxy) are NOT live-driven, so
                                         they stay excluded+ungated — a future W-item. -->
                                    <includes>
                                        <include>**/workbench/transport/WorkbenchTransportClient*</include>
                                        <include>**/workbench/auth/Login*</include>
                                        <include>**/workbench/auth/BootstrapAdminAuth*</include>
                                        <include>**/workbench/WorkbenchHttp*</include>
                                        <include>**/workbench/pipeline/PipelinesClient*</include>
                                        <include>**/workbench/jobs/JobsClient*</include>
                                        <include>**/workbench/sessions/SessionsClient*</include>
                                        <include>**/workbench/containers/ContainersClient*</include>
                                    </includes>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <!-- Live run measures ~57.5% over these classes
                                                         (2026-06-16); 0.54 leaves a ~3pt buffer on a
                                                         brand-new gate. Never decrease without a
                                                         recorded reason; ratchet as the live test grows. -->
                                                    <minimum>0.54</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
