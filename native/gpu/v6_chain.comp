#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require

/* The V6 segment encoder, on the GPU.
 *
 * Port of native/src/v6_model.h (Fenwick-backed adaptive model) and
 * native/src/rc_cram.c (rc_cram_encode, shift_low, encoder_finish).
 * All 32-bit integer arithmetic with wraparound, which GLSL matches
 * exactly, so output is expected byte-identical to the CPU coder.
 *
 * One chain per invocation. Per context the model is 2*nsym+2 u16:
 * freq[0..nsym-1] then a 1-based Fenwick tree of nsym+1 entries.
 */

layout(local_size_x_id = 0) in;

layout(std430, binding = 0) readonly buffer Q  { uint8_t  qidx[]; };
layout(std430, binding = 1) readonly buffer L  { uint     lens[]; };
layout(std430, binding = 2) readonly buffer Ch { uint     chain[]; };
layout(std430, binding = 3)          buffer M  { uint16_t model[]; };
layout(std430, binding = 4)          buffer TF { uint     totf[]; };
layout(std430, binding = 5)          buffer O  { uint8_t  obuf[]; };
layout(std430, binding = 6)          buffer OL { uint     olen[]; };
layout(std430, binding = 7) readonly buffer T  { uint16_t tmpl[]; };
layout(std430, binding = 8) readonly buffer QM { uint8_t  qmap[]; };

layout(push_constant) uniform P {
    uint n_ctx;
    uint nsym;
    uint stride;      /* 2 * nsym + 2 */
    uint seed_total;
    uint qbits;
    uint qshift;
    uint pbits;
    uint pshift;
    uint dbits;
    uint out_stride;
    uint n_chains;
    uint chain_base;
} pc;

const uint SM_MAX_FREQ = (1u << 16) - 17u;
const uint SM_STEP     = 16u;
const uint TOP         = 1u << 24;
const uint THRES       = 255u * (1u << 24);

uint e_low, e_range, e_carry, e_ffnum, e_cache, e_pos, e_err;
uint obase, ocap;
uint mbase, tbase;

uint lsb(uint i) { return i & (~i + 1u); }

void emit(uint b)
{
    if (e_pos < ocap) {
        obuf[obase + e_pos] = uint8_t(b & 0xFFu);
        e_pos++;
    } else {
        e_err = 1u;
    }
}

void shift_low()
{
    if (e_low < THRES || e_carry != 0u) {
        emit(e_cache + e_carry);
        while (e_ffnum != 0u) {
            emit(e_carry - 1u);
            e_ffnum--;
        }
        e_cache = e_low >> 24;
        e_carry = 0u;
    } else {
        e_ffnum++;
    }
    e_low = e_low << 8;
}

void rc_encode(uint cf, uint f, uint T)
{
    uint tmp = e_low;
    e_range = e_range / T;
    e_low   = e_low + cf * e_range;
    e_range = e_range * f;
    e_carry = e_carry + (e_low < tmp ? 1u : 0u);
    while (e_range < TOP) {
        e_range = e_range << 8;
        shift_low();
    }
}

/* v6_model.h: sum of freq[0 .. s-1] */
uint model_prefix(uint base, uint s)
{
    uint acc = 0u;
    for (uint i = s; i > 0u; i -= lsb(i)) {
        acc += uint(model[base + pc.nsym + i]);
    }
    return acc;
}

void tree_build(uint base)
{
    for (uint i = 1u; i <= pc.nsym; i++) {
        model[base + pc.nsym + i] = model[base + i - 1u];
    }
    for (uint i = 1u; i <= pc.nsym; i++) {
        uint j = i + lsb(i);
        if (j <= pc.nsym) {
            model[base + pc.nsym + j] = uint16_t(
                uint(model[base + pc.nsym + j])
                + uint(model[base + pc.nsym + i]));
        }
    }
}

void model_update(uint base, uint ctx, uint s)
{
    model[base + s] = uint16_t(uint(model[base + s]) + SM_STEP);
    for (uint i = s + 1u; i <= pc.nsym; i += lsb(i)) {
        model[base + pc.nsym + i] =
            uint16_t(uint(model[base + pc.nsym + i]) + SM_STEP);
    }
    uint tot = totf[tbase + ctx] + SM_STEP;

    if (tot > SM_MAX_FREQ) {
        tot = 0u;
        for (uint i = 0u; i < pc.nsym; i++) {
            uint f = uint(model[base + i]);
            f -= f >> 1;
            model[base + i] = uint16_t(f);
            tot += f;
        }
        tree_build(base);
    }
    totf[tbase + ctx] = tot;
}

void main()
{
    uint c = pc.chain_base + gl_GlobalInvocationID.x;
    if (c >= pc.n_chains) return;

    uint first  = chain[c * 4u + 0u];
    uint nreads = chain[c * 4u + 1u];
    uint qoff   = chain[c * 4u + 2u];

    mbase = c * pc.n_ctx * pc.stride;
    tbase = c * pc.n_ctx;
    obase = c * pc.out_stride;
    ocap  = pc.out_stride;

    /* Cold model per segment. Every context starts from the same
     * seeded state, prepared host-side, so this is a copy. */
    for (uint ctx = 0u; ctx < pc.n_ctx; ctx++) {
        uint base = mbase + ctx * pc.stride;
        for (uint j = 0u; j < pc.stride; j++) {
            model[base + j] = tmpl[j];
        }
        totf[tbase + ctx] = pc.seed_total;
    }

    e_low   = 0u;
    e_range = 0xFFFFFFFFu;
    e_carry = 0u;
    e_ffnum = 0u;
    e_cache = 0u;
    e_pos   = 0u;
    e_err   = 0u;

    uint qmask = (1u << pc.qbits) - 1u;
    uint pmax  = (1u << pc.pbits) - 1u;
    uint dmax  = (1u << pc.dbits) - 1u;
    uint ploc  = pc.qbits;
    uint dloc  = pc.qbits + pc.pbits;

    uint k = qoff;
    for (uint r = 0u; r < nreads; r++) {
        uint len  = lens[first + r];
        uint qctx = 0u, qp = 0u, qpp = 0u;
        for (uint i = 0u; i < len; i++, k++) {
            uint pos = min(pmax, (len - 1u - i) >> pc.pshift);
            uint d = 0u;
            if (i >= 2u) {
                uint ad = qp > qpp ? qp - qpp : qpp - qp;
                d = min(dmax, ad);
            }
            uint ctx  = (qctx & qmask) | (pos << ploc) | (d << dloc);
            uint base = mbase + ctx * pc.stride;
            /* qidx carries raw quality bytes; the alphabet map turns
             * them into dense symbols, exactly as the CPU coder does
             * inside its own loop. A symbol outside the alphabet would
             * find a zero frequency, and the coder would then
             * renormalise a zero range forever, hanging the device.
             * Clamping costs nothing and makes that unreachable. */
            uint sym = uint(qmap[uint(qidx[k])]);
            if (sym >= pc.nsym) sym = 0u;

            rc_encode(model_prefix(base, sym), uint(model[base + sym]),
                      totf[tbase + ctx]);
            model_update(base, ctx, sym);

            qctx = (qctx << pc.qshift) + sym;
            qpp = qp;
            qp  = sym;
        }
    }

    for (uint i = 0u; i < 5u; i++) {
        shift_low();
    }

    olen[c] = e_err != 0u ? 0xFFFFFFFFu : e_pos;
}
